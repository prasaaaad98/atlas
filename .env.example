# Copy this file to `.env` (same folder) and fill in values.
# `.env` is gitignored: real keys never go into git, chat, logs or bronze files.
# Read by pipeline fetch tasks only (from Slice B4d); unit and golden tests never need keys.

# EIA Open Data API key (Henry Hub gas prices, Slice B4d).
# Register at the EIA website; terms are recorded in docs/data/sources/eia.md before any fetch.
EIA_API_KEY=

# ENTSO-E Transparency Platform security token (Slice B3); fill in once registered.
ENTSOE_API_TOKEN=
