# Go build output
/bin/
*.exe
*.test
*.out
coverage.*

# Local environment and secrets (never commit real keys)
.env
.env.*
!.env.example

# Local Postgres data if mounted into the repo
/data/

# Local data lake (default LAKE_ROOT) and Python environments
/lake/
.venv/
__pycache__/
*.egg-info/
.pytest_cache/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude Code local-only settings
.claude/settings.local.json

# Plans, agent guidance, ADRs and notes stay local; only the root README is published
*.md
!/README.md

# Local-only data (e.g. Mendeley datasets with India prices): testing, validation
# and evaluation on this PC only. Never committed, published or used in CI.
/local_only/
/pipelines/tests/fixtures_local/
